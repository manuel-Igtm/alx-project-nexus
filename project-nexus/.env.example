# Project Nexus E-Commerce Backend - Environment Configuration
# Copy this file to .env and update the values

# =============================================================================
# CORE SETTINGS
# =============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Django settings
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL database URL (for production)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# =============================================================================
# REDIS
# =============================================================================

# Redis URL for caching and Celery
REDIS_URL=redis://localhost:6379

# =============================================================================
# CELERY
# =============================================================================

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# JWT SETTINGS
# =============================================================================

# Token lifetimes in minutes/days
JWT_ACCESS_LIFETIME=30
JWT_REFRESH_LIFETIME=7

# =============================================================================
# CORS SETTINGS
# =============================================================================

# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

# CSRF trusted origins
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# EMAIL SETTINGS
# =============================================================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@projectnexus.com

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO

# =============================================================================
# THIRD-PARTY SERVICES
# =============================================================================

# Chapa Payment Gateway
# CHAPA_SECRET_KEY=your-chapa-secret-key

# M-Pesa API
# MPESA_CONSUMER_KEY=your-mpesa-consumer-key
# MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
